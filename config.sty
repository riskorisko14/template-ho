% ============================================================
%  config.sty
%  Replika presisi desain Template_Laporan_Praktikum_Jarkom.docx
%  Wajib dikompilasi dengan XeLaTeX (menggunakan fontspec)
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config}[2025/01/01 Replika desain Word - Laporan Praktikum Jarkom ITERA]

% ---------------------------------------------------
% 1. UKURAN HALAMAN & MARGIN (identik dengan file .docx asli)
%    Dokumen asli berukuran B5 (176mm x 250mm / 9979 x 14175 twips).
%    Margin cover: 0.665in (~1.69cm). Margin isi: 1in, header/footer 0.5in.
% ---------------------------------------------------
\RequirePackage[
  paperwidth=176mm, paperheight=250mm,
  top=1.69cm, bottom=1.69cm, left=1.69cm, right=1.69cm
]{geometry}
\newcommand{\coverGeometry}{\newgeometry{paperwidth=176mm,paperheight=250mm,top=1.69cm,bottom=1.69cm,left=1.69cm,right=1.69cm}}
\newcommand{\bodyGeometry}{\newgeometry{paperwidth=176mm,paperheight=250mm,top=2.54cm,bottom=2.54cm,left=2.54cm,right=2.54cm,headheight=14pt,headsep=20pt,footskip=28pt}}

% ---------------------------------------------------
% 2. FONT (XeLaTeX + fontspec)
%    Body   : EB Garamond   (pengganti bebas-lisensi untuk "Garamond")
%    Heading: Archivo Black (pengganti bebas-lisensi untuk "Arial Black")
% ---------------------------------------------------
\RequirePackage{fontspec}
\setmainfont{EBGaramond-Regular.ttf}[
  Path = fonts/,
  BoldFont = EBGaramond-Bold.ttf,
  ItalicFont = EBGaramond-Italic.ttf,
  BoldItalicFont = EBGaramond-BoldItalic.ttf
]
\newfontfamily\headingfont{ArchivoBlack-Regular.ttf}[Path = fonts/]
\newfontfamily\bodyfont{EBGaramond-Regular.ttf}[
  Path = fonts/,
  BoldFont = EBGaramond-Bold.ttf,
  ItalicFont = EBGaramond-Italic.ttf,
  BoldItalicFont = EBGaramond-BoldItalic.ttf
]

\RequirePackage{graphicx}
\graphicspath{{figures/}}

\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{fancyhdr}
\RequirePackage{caption}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{colortbl}
\RequirePackage{tikz}
\RequirePackage{lastpage}
\RequirePackage{ragged2e}
\RequirePackage{amssymb}
\RequirePackage{float}

