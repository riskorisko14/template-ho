% ---------------------------------------------------
% 5. HEADER & FOOTER HALAMAN ISI
%    Header asli: "LAPORAN PRAKTIKUM" (Arial Black, small-caps, huruf renggang)
%    di kiri, "Teknik Informatika ITERA" di kanan, dengan garis bawah tebal
%    bergaya "thinThick" (dua garis: tipis lalu tebal).
%    Footer asli: garis tipis + nomor halaman tebal rata kanan.
% ---------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt} % Digambar manual (2 garis) lewat \headrule
\renewcommand{\footrulewidth}{0pt} % Digambar manual lewat \footrule

\fancyhead[L]{\headingfont\fontsize{7}{9}\selectfont\addfontfeature{LetterSpace=8.0}LAPORAN PRAKTIKUM}
\fancyhead[R]{\fontsize{8}{10}\selectfont Teknik Informatika ITERA}
\renewcommand{\headrule}{%
  \hbox to\headwidth{\color{black}\leaders\hrule height 0.5pt\hfill}%
}

\fancyfoot[R]{\fontsize{9}{11}\selectfont\bfseries\thepage}
\renewcommand{\footrule}{\hbox to\headwidth{\color{black}\leaders\hrule height 0.5pt\hfill}}

% Gaya halaman kosong (tanpa header/footer) untuk cover
\fancypagestyle{cover}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \renewcommand{\headrule}{}
  \renewcommand{\footrule}{}
}

% ---------------------------------------------------
% 6. GAYA JUDUL (meniru style "Title"/"SectionLabel" dokumen asli:
%    Arial Black, abu-abu 808080, tracking rapat, TANPA numbering)
% ---------------------------------------------------
\newcommand{\grayTitle}[1]{%
  {\headingfont\fontsize{22}{26}\selectfont\color{grayHead}\addfontfeature{LetterSpace=-2.0}#1}%
}

% Judul section konten (meniru paragraf bold 20pt tengah pada Word: "Dokumentasi Praktikum", dsb.)
\newcommand{\contentHeading}[1]{%
  \par\vspace{18pt}
  {\centering\bfseries\fontsize{20}{24}\selectfont #1\par}
  \vspace{10pt}%
}

% Sub-judul (meniru "Heading2b": Arial, bold-italic, 12pt, rata kiri-kanan)
\newcommand{\subHeading}[1]{%
  \par\vspace{8pt}
  {\bfseries\itshape\sffamily\fontsize{12}{15}\selectfont #1\par}
  \vspace{4pt}%
}

% ---------------------------------------------------
% 7. CAPTION GAMBAR & TABEL (format "Gambar 1. ..." / "Tabel 1. ...")
% ---------------------------------------------------
\captionsetup{
  labelsep=period,
  font={small},
  justification=centering
}
\AtBeginDocument{%
  \renewcommand{\figurename}{Gambar}
  \renewcommand{\tablename}{Tabel}
}

% ---------------------------------------------------
% 8. KOTAK "RANGKUMAN PRAKTIKUM" (meniru tabel 1x1 berbingkai hitam
%    tipis pada dokumen asli, latar putih)
% ---------------------------------------------------
\setlength{\fboxrule}{0.5pt}
\setlength{\fboxsep}{10pt}
\newenvironment{rangkumanbox}{%
  \par\vspace{4pt}
  \noindent
  \begin{lrbox}{\rangkumanbuffer}
  \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule}
}{%
  \end{minipage}
  \end{lrbox}
  \fbox{\usebox{\rangkumanbuffer}}\par\vspace{4pt}
}
\newsavebox{\rangkumanbuffer}

% ---------------------------------------------------
% 9. TABEL BERGAYA "Grid Table 4 - Accent 1" (header biru + pita terang)
% ---------------------------------------------------
% \tblheaderrow : dipasang SEKALI di awal baris header (memberi latar biru)
% \thc{...}     : membungkus teks tiap sel header (putih + tebal)
\newcommand{\tblheaderrow}{\rowcolor{tblHeaderBlue}}
\newcommand{\thc}[1]{{\color{white}\bfseries #1}}
% \tblbandrow : pita biru muda selang-seling. Overhang warna sengaja dikurangi
%               0.4pt agar garis vertikal tabel tetap terlihat (tidak tertutup).
\newcommand{\tblbandrow}{%
  \rowcolor{tblBandBlue}[\dimexpr\tabcolsep-0.4pt\relax][\dimexpr\tabcolsep-0.4pt\relax]%
}
\arrayrulecolor{tblBorderBlue}

% ---------------------------------------------------
% 10. DAFTAR ITEM: bulat penuh (level 1) & lingkaran kosong "o" (level 2)
%     -- meniru "List Bullet" & "List Bullet 2" pada dokumen asli
% ---------------------------------------------------
\setlist[itemize,1]{label=\textbullet, leftmargin=1.6em, itemsep=4pt, topsep=4pt}
\setlist[itemize,2]{label=o, leftmargin=1.6em, itemsep=2pt, topsep=2pt}
\setlist[enumerate]{leftmargin=1.6em, itemsep=2pt, topsep=4pt}

% Baris spasi 1.5 pada paragraf isi (meniru w:spacing line="360" lineRule="auto")
\linespread{1.28}
\hyphenpenalty=10000
\exhyphenpenalty=10000
\sloppy

\endinput
